{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SongBrief",
  "type": "object",
  "additionalProperties": false,
  "required": ["slots", "output", "questions_asked", "skipped"],
  "properties": {
    "slots": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "output": { "$ref": "slot_value.json" },
        "mood": { "$ref": "slot_value.json" },
        "energy": { "$ref": "slot_value.json" },
        "world": { "$ref": "slot_value.json" },
        "key": { "$ref": "slot_value.json" },
        "style": { "$ref": "slot_value.json" },
        "palette": { "$ref": "slot_value.json" },
        "structure": { "$ref": "slot_value.json" },
        "must_keep": { "$ref": "slot_value.json" },
        "tempo": { "$ref": "slot_value.json" },
        "sound": { "$ref": "slot_value.json" },
        "genre": { "$ref": "slot_value.json" },
        "brightness": { "$ref": "slot_value.json" },
        "pattern": { "$ref": "slot_value.json" },
        "production": { "$ref": "slot_value.json" },
        "progression": { "$ref": "slot_value.json" },
        "meter": { "$ref": "slot_value.json" },
        "intent": { "$ref": "slot_value.json" }
      }
    },
    "output": {
      "type": "array",
      "items": { "$ref": "output_choice.json" }
    },
    "questions_asked": { "type": "integer" },
    "skipped": {
      "type": "array",
      "items": { "$ref": "slot_name.json" }
    },
    "facets": {
      "type": "array",
      "items": { "$ref": "facet_answer.json" }
    },
    "arc": { "$ref": "arc.json" },
    "audio_intent": { "type": "string", "enum": ["transform", "extend", "accompany"] },
    "noise": { "type": "number" },
    "coverage": { "type": "number" }
  }
}
