{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AudioFeatures",
  "type": "object",
  "additionalProperties": false,
  "required": ["input_type", "confidence"],
  "properties": {
    "input_type": { "$ref": "input_type.json" },
    "key": { "type": "string" },
    "mode": { "type": "string" },
    "bpm": { "type": "number" },
    "chords": {
      "type": "array",
      "items": { "type": "string" }
    },
    "instruments": {
      "type": "array",
      "items": { "type": "string" }
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}
