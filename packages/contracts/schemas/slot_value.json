{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SlotValue",
  "type": "object",
  "additionalProperties": false,
  "required": ["value", "source", "reason", "confidence"],
  "properties": {
    "value": { "type": "string" },
    "source": { "$ref": "slot_source.json" },
    "reason": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}
