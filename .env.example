# copy to .env (never committed)
STABILITY_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Extra Gemini keys (comma-separated, e.g. from a second free-tier project). When a key hits its daily quota on a flash model the
# ears rotate to the next key on the SAME model before falling down to lite models, so judging stays flash-quality mid-demo.
GEMINI_API_KEYS=
# Paid tier: GEMINI_PAID=1 (or GEMINI_TIER=paid) never uses lite models; if every key is out of quota, judging FAILS loudly instead
# of silently degrading to a lite judge. Leave empty on free tier (lite fallback, results carry scoreNote "lite judge, lower confidence").
GEMINI_PAID=
# Optional overrides: GEMINI_MODEL, GEMINI_JUDGE_MODELS (max 3, comma-separated), GEMINI_FALLBACK_MODELS
HF_TOKEN=
# Soundcharts (song metadata: genres, producers, labels, tempo/key/energy). Leave empty for the public sandbox
# (only Billie Eilish / Tones & I / David Bowie test data). Either OAuth client credentials or legacy app id + key:
SOUNDCHARTS_CLIENT_ID=
SOUNDCHARTS_CLIENT_SECRET=
SOUNDCHARTS_APP_ID=
SOUNDCHARTS_API_KEY=
